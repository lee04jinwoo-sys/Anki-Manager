[Unit]
Description=Daily snapshot of Anki Manager data/ into ~/backups/anki-manager (keeps 14)

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/anki-manager
EnvironmentFile=-/home/ubuntu/anki-manager/.env.telegram
EnvironmentFile=-/home/ubuntu/anki-manager/telegram_chat.env
ExecStart=/home/ubuntu/anki-manager/.venv/bin/python -m utils.data_backup
Nice=10
